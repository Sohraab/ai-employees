DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_employees
PORT=3000
# Public HTTPS address Slack can reach (used in app manifests and the install redirect)
PUBLIC_URL=https://ai.example.com
# 32 random bytes, base64. Encrypts Slack credentials in the database. Keep it safe.
SECRETS_KEY=
# Bearer token for /admin endpoints
ADMIN_TOKEN=

# Claude (each employee's model and effort are set per agent in the database)
ANTHROPIC_API_KEY=
# Effort for employees that don't set their own: low | medium | high | xhigh | max
AGENT_EFFORT=high
WORKER_CONCURRENCY=4

# Slack apps are created automatically (npm run slack:connect / slack:hire) and stored encrypted.
# Only for apps created by hand: suffix = agent slug, upper-cased, "-" -> "_"
SLACK_BOT_TOKEN__SOURCER=
SLACK_SIGNING_SECRET__SOURCER=
SLACK_BOT_TOKEN__OPS_REPORTER=
SLACK_SIGNING_SECRET__OPS_REPORTER=

# One Executor scoped connection per AI employee. Suffix = agent's executor_workspace
EXECUTOR_URL__SOURCER=
EXECUTOR_TOKEN__SOURCER=
EXECUTOR_URL__OPS_REPORTER=
EXECUTOR_TOKEN__OPS_REPORTER=
