{
  "name": "ai-employees",
  "version": "0.1.0",
  "private": true,
  "description": "AI employees with their own memory, skills, tools, routines and access rules, reachable from Slack, email, WhatsApp and phone.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "slack:manifest": "tsx src/scripts/slack-manifest.ts",
    "executor:check": "tsx src/scripts/executor-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^2.1.9",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@slack/web-api": "^8.4.0",
    "drizzle-orm": "^0.44.0",
    "hono": "^4.13.19",
    "pg-boss": "^12.38.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
